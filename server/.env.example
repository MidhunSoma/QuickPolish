# QuickPolish Vercel Proxy Configuration
# You can supply 1 to 4+ Gemini API keys.
# Free Gemini Flash keys can be generated at: https://aistudio.google.com/app/apikey

# Method 1: Comma-separated list of keys (recommended)
GEMINI_API_KEYS=AIzaSyA_key1...,AIzaSyB_key2...,AIzaSyC_key3...

# Method 2: Individual key environment variables
# GEMINI_API_KEY_1=AIzaSyA_key1...
# GEMINI_API_KEY_2=AIzaSyB_key2...
# GEMINI_API_KEY_3=AIzaSyC_key3...
# GEMINI_API_KEY_4=AIzaSyD_key4...

# Optional: Gemini model override (defaults to gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash
